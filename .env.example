# Bitget API credentials (read-only key is sufficient for polling orders)
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_BASE_URL=https://api.bitget.com

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Poller
POLL_INTERVAL_SECONDS=60

# State persistence (json today; redis stub reserved for scaling)
STATE_BACKEND=json
STATE_FILE_PATH=./data/state.json

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
